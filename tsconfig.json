{
  "extends": "@schnau/tsconfig/effect",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node"],
    // This list replaces the base's `plugins`, so it repeats the Effect entry.
    "plugins": [
      {
        "name": "@effect/language-service",
        // The unstable Effect 4 modules the client and its tests build on. Any other unstable API still fails.
        "allowedUnstableApis": [
          "effect/http",
          "effect/persistence/RateLimiter",
          "effect/LayerMap",
          "@effect/vitest"
        ]
      }
    ]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "*.config.ts"],
  "exclude": ["dist", "node_modules", "test/consumer"]
}

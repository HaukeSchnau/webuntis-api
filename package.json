{
  "name": "webuntis-api",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./schemas": "./src/domains/schemas.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:contract": "vitest run test/contract",
    "test:live": "vitest run test/live",
    "test:live:sops": "./scripts/run-live-tests.sh",
    "test:live:sops:update": "./scripts/run-live-tests.sh -u",
    "test:watch": "vitest",
    "typecheck": "tsgo --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@types/node": "^25.6.0",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "@effect/vitest": "^4.0.0-beta.50",
    "@typescript/native-preview": "^7.0.0-dev.20260417.1",
    "effect": "^4.0.0-beta.50"
  }
}

{
  "name": "webuntis-api",
  "version": "0.1.0",
  "description": "Read-only Effect client for WebUntis APIs.",
  "files": [
    "dist",
    "README.md",
    "MIGRATION.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "import": "./dist/schemas.js"
    }
  },
  "publishConfig": {
    "registry": "https://npm.schnau.dev"
  },
  "scripts": {
    "prepare": "effect-tsgo patch",
    "prepack": "just build",
    "prepublishOnly": "just lint && just test && just pack-check"
  },
  "dependencies": {
    "effect": "^4.0.0-beta.98"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@effect/tsgo": "^0.21.0",
    "@effect/vitest": "^4.0.0-beta.98",
    "@types/node": "^26.1.1",
    "publint": "^0.3.21",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@11.9.0"
}

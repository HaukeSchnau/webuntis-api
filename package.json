{
  "name": "webuntis-api",
  "version": "0.2.1",
  "description": "Read-only Effect client for WebUntis APIs.",
  "files": [
    "dist",
    "README.md",
    "MIGRATION.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "import": "./dist/schemas.js"
    }
  },
  "publishConfig": {
    "registry": "https://npm.schnau.dev"
  },
  "scripts": {
    "prepare": "effect-tsgo patch",
    "prepack": "just build",
    "prepublishOnly": "just lint && just test && just pack-check"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@effect/tsgo": "^0.36.4",
    "@effect/vitest": "^4.0.0-rc.108",
    "@types/node": "^26.2.0",
    "effect": "^4.0.0-rc.108",
    "publint": "^0.3.23",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "^4.0.0-rc.108"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.21.0"
}
